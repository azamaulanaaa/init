{
  "name": "node-vite-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" index.html vite.config.ts \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" index.html vite.config.ts \"*.json\"",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "^26",
    "prettier": "^3",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "^5"
  }
}
